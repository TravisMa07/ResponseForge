          "$ref": "#/$defs/EndpointRef"
        },
        "resource": {
          "minLength": 1,
          "title": "Resource",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "endpoint",
        "resource"
      ],
      "title": "ActionTarget",
      "type": "object"
    },
    "ActionType": {
      "enum": [
        "terminate_process",
        "quarantine_file",
        "block_indicator",
        "isolate_host",
        "unisolate_host",
        "disable_persistence",
        "test_marker"
      ],
      "title": "ActionType",
      "type": "string"
    },
    "EndpointRef": {
      "additionalProperties": false,
      "properties": {
        "agent_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent Id"
        },
        "endpoint_id": {
          "minLength": 1,
          "title": "Endpoint Id",
          "type": "string"
        },
        "hostname": {
          "minLength": 1,
          "title": "Hostname",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "endpoint_id",
        "hostname"
      ],
      "title": "EndpointRef",
      "type": "object"
    },
    "Mode": {
      "enum": [
        "replay",
        "live"
      ],
      "title": "Mode",
      "type": "string"
    },
    "Risk": {
      "enum": [
        "non_disruptive",
        "disruptive"
      ],
      "title": "Risk",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "approval_id": {
      "minLength": 1,
      "title": "Approval Id",
      "type": "string"
    },
    "approver_id": {
      "minLength": 1,
      "title": "Approver Id",
      "type": "string"
    },
    "decided_at": {
      "format": "date-time",
      "title": "Decided At",
      "type": "string"
    },
    "decision": {
      "enum": [
        "approved",
        "rejected",
        "cancelled"
      ],
      "title": "Decision",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "proposal": {
      "$ref": "#/$defs/ActionProposal"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
