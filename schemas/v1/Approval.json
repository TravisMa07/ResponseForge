        "action": {
          "$ref": "#/$defs/ActionType"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "idempotency_key": {
          "minLength": 1,
          "title": "Idempotency Key",
          "type": "string"
        },
        "incident_id": {
          "minLength": 1,
          "title": "Incident Id",
          "type": "string"
        },
        "mode": {
          "$ref": "#/$defs/Mode"
        },
        "proposal_id": {
          "minLength": 1,
          "title": "Proposal Id",
          "type": "string"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "risk": {
          "$ref": "#/$defs/Risk"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/ActionTarget"
        }
      },
      "required": [
        "proposal_id",
        "incident_id",
        "mode",
        "target",
        "action",
        "rationale",
        "risk",
        "created_at",
        "expires_at",
        "idempotency_key"
