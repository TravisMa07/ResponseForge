{
  "$defs": {
    "EndpointRef": {
      "additionalProperties": false,
      "properties": {
        "agent_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent Id"
        },
        "endpoint_id": {
          "minLength": 1,
          "title": "Endpoint Id",
          "type": "string"
        },
        "hostname": {
          "minLength": 1,
          "title": "Hostname",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "endpoint_id",
        "hostname"
      ],
      "title": "EndpointRef",
      "type": "object"
    },
    "Mode": {
      "enum": [
        "replay",
        "live"
      ],
      "title": "Mode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifact": {
      "enum": [
        "process",
        "network",
        "file",
        "persistence"
      ],
      "title": "Artifact",
      "type": "string"
    },
    "end": {
      "format": "date-time",
      "title": "End",
      "type": "string"
    },
    "endpoint": {
      "$ref": "#/$defs/EndpointRef"
    },
    "incident_id": {
      "minLength": 1,
      "title": "Incident Id",
      "type": "string"
    },
    "mode": {
      "$ref": "#/$defs/Mode"
    },
    "scenario_id": {
      "minLength": 1,
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "start": {
      "format": "date-time",
      "title": "Start",
      "type": "string"
    }
  },
  "required": [
    "incident_id",
    "mode",
    "scenario_id",
    "endpoint",
    "start",
    "end",
    "artifact"
  ],
  "title": "CollectionRequest",
  "type": "object"
}
