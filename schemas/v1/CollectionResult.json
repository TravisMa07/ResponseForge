{
  "$defs": {
    "EndpointRef": {
      "additionalProperties": false,
      "properties": {
        "agent_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent Id"
        },
        "endpoint_id": {
          "minLength": 1,
          "title": "Endpoint Id",
          "type": "string"
        },
        "hostname": {
          "minLength": 1,
          "title": "Hostname",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "endpoint_id",
        "hostname"
      ],
      "title": "EndpointRef",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "availability": {
          "enum": [
            "available",
            "unavailable"
          ],
          "title": "Availability",
          "type": "string"
        },
        "classification": {
          "default": "sensitive",
          "enum": [
            "public",
            "sensitive"
          ],
          "title": "Classification",
          "type": "string"
        },
        "collected_at": {
          "format": "date-time",
          "title": "Collected At",
          "type": "string"
        },
        "endpoint": {
          "$ref": "#/$defs/EndpointRef"
        },
        "evidence_id": {
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "incident_id": {
          "minLength": 1,
          "title": "Incident Id",
          "type": "string"
        },
        "mode": {
          "$ref": "#/$defs/Mode"
        },
        "observed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Observed At"
        },
        "provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/Provenance"
            },
            {
              "type": "null"
            }
          ]
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "unavailable_reason": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Unavailable Reason"
        }
      },
      "required": [
        "evidence_id",
        "incident_id",
        "mode",
        "endpoint",
        "observed_at",
        "collected_at",
        "availability",
        "provenance",
        "unavailable_reason"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Mode": {
      "enum": [
        "replay",
        "live"
      ],
      "title": "Mode",
      "type": "string"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "original_event_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Original Event Ids",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "source_ref": {
          "minLength": 1,
          "title": "Source Ref",
          "type": "string"
        }
      },
      "required": [
        "source",
        "source_ref",
        "sha256",
        "original_event_ids"
      ],
      "title": "Provenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "title": "Evidence",
      "type": "array"
    },
    "gaps": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Gaps",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "evidence",
    "gaps"
  ],
  "title": "CollectionResult",
  "type": "object"
}
