ARG GO_IMAGE
ARG RUNTIME_IMAGE
FROM ${GO_IMAGE} AS build
ENV GOTOOLCHAIN=local CGO_ENABLED=0 GOMAXPROCS=2
WORKDIR /build
COPY worker/go.mod worker/go.sum ./
RUN go mod download && go mod verify
COPY worker/*.go ./
RUN go build -mod=readonly -p=2 -trimpath -o /out/worker .

FROM ${RUNTIME_IMAGE}
WORKDIR /app
COPY --from=build /out/worker /app/worker
COPY worker/LICENSE /usr/share/licenses/shuffle/LICENSE
CMD ["/app/worker"]
