ARG GO_IMAGE
ARG RUNTIME_IMAGE
FROM ${GO_IMAGE} AS build
ENV GOTOOLCHAIN=local CGO_ENABLED=0 GOMAXPROCS=2
WORKDIR /build
COPY orborus/go.mod orborus/go.sum ./
RUN go mod download && go mod verify
COPY orborus/*.go ./
RUN go build -mod=readonly -p=2 -trimpath -o /out/orborus .

FROM ${RUNTIME_IMAGE}
WORKDIR /app
COPY --from=build /out/orborus /app/orborus
COPY orborus/LICENSE /usr/share/licenses/shuffle/LICENSE
CMD ["/app/orborus"]
